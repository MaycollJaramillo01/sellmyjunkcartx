---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CTASection from '../components/CTASection.astro';
const schema = [{ '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Home', item: 'https://sellmyjunkcartx.com/' }, { '@type': 'ListItem', position: 2, name: 'Areas served', item: 'https://sellmyjunkcartx.com/areas' }] }, { '@type': 'Service', name: 'Vehicle pickup in Houston', areaServed: { '@type': 'City', name: 'Houston', containedInPlace: { '@type': 'State', name: 'Texas' } }, provider: { '@type': 'LocalBusiness', name: 'Sell My Junk Car TX', telephone: '+1-832-622-2792' } }];
---
<BaseLayout title="Houston Vehicle Pickup Areas | Sell My Junk Car TX" description="Sell your used, damaged or non-running vehicle in Houston and surrounding areas. Confirm pickup coverage before scheduling." canonical="/areas" schema={schema}>
  <PageHero eyebrow="Local Houston service" title="Houston pickup, clearly arranged." description="The service covers Houston and surrounding areas. Share your location before scheduling." pageName="Areas served" />
  <section class="section"><div class="container benefit-layout"><div class="benefit-copy reveal"><h2>Coverage starts with the actual location.</h2><p>Share the pickup point so the team can confirm service before scheduling.</p><div class="benefit-list"><div class="benefit-item"><strong>Houston</strong><span>The primary market stated by the company.</span></div><div class="benefit-item"><strong>Surrounding areas</strong><span>Contact the team to confirm your location.</span></div><div class="benefit-item"><strong>Accessible pickup</strong><span>The vehicle must be reachable by the loading unit.</span></div><div class="benefit-item"><strong>Completed sale</strong><span>Free towing applies when the transaction is completed.</span></div></div></div><div class="benefit-media reveal"><img src="/assets/img/hero-tow-pickup.webp" alt="Tow truck ready for a vehicle pickup at a Houston home" width="1536" height="1024" loading="lazy" /></div></div></section>
  <section class="section section-soft"><div class="narrow prose"><h2>Check your pickup location</h2><p>Send the vehicle location through WhatsApp or call the team. Exact address information is used to coordinate towing and is handled according to the Privacy Policy.</p><div class="button-row"><a class="button button-primary" href="https://wa.me/18326222792" target="_blank" rel="noopener" data-track="whatsapp_clicked">Confirm on WhatsApp</a><a class="button button-outline" href="tel:+18326222792" data-track="phone_clicked">Call (832) 622-2792</a></div></div></section>
  <CTASection title="Have a vehicle in the Houston area?" text="Start the offer request and confirm the pickup point." secondary={false} />
</BaseLayout>

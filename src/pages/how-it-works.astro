---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CTASection from '../components/CTASection.astro';
const schema = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Home', item: 'https://sellmyjunkcartx.com/' }, { '@type': 'ListItem', position: 2, name: 'How it works', item: 'https://sellmyjunkcartx.com/how-it-works' }] };
---
<BaseLayout title="How Selling Your Car Works | Sell My Junk Car TX" description="See how the Houston vehicle sale process moves from a preliminary offer to inspection, payment and pickup." canonical="/how-it-works" image="/assets/img/process-handover-v2.webp" schema={schema}>
  <PageHero eyebrow="A three-part process" title="Offer. Inspection. Pickup." description="Every step is tied to the actual vehicle, valid documents and clear final terms." pageName="How it works" image="/assets/img/process-handover-v2.webp" imageAlt="Car key and transfer paperwork on a vehicle hood at a Houston tow yard" />
  <section class="section"><div class="container process-layout"><div class="process-media reveal"><img src="/assets/img/hero-tow-pickup.webp" alt="Operator reviewing a vehicle before tow truck pickup" width="1536" height="1024" loading="lazy" /></div><div class="process-list">
    <article class="process-item reveal"><span>01</span><div><h2>Request a preliminary offer</h2><p>Call, use WhatsApp or complete the online request with the vehicle make, model, year and condition.</p></div></article>
    <article class="process-item reveal"><span>02</span><div><h2>Confirm the vehicle</h2><p>The team reviews the vehicle through a visual and technical inspection. If its actual condition differs from the description, the preliminary offer may change or be canceled.</p></div></article>
    <article class="process-item reveal"><span>03</span><div><h2>Transfer, payment and pickup</h2><p>Once the documentation is verified, the transfer papers are signed and payment is made by cash, transfer or check. Free towing applies when the sale is completed and the vehicle is accessible.</p></div></article>
  </div></div></section>
  <section class="section section-soft"><div class="narrow prose"><h2>What to have ready</h2><p>You must be the legal owner or have valid authorization to sell the vehicle. The documentation needed for transfer must be available, and the condition you provide should be accurate.</p><div class="notice"><strong>Before pickup:</strong> remove personal items, toll tags and license plates when appropriate. The company is not responsible for belongings left in the vehicle.</div><h2>About the first quote</h2><p>Online and phone quotes are preliminary. The final amount is confirmed only after the vehicle has been inspected.</p></div></section>
  <CTASection title="Start with your vehicle details." text="The request takes three short steps." />
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
const schema = { '@context': 'https://schema.org', '@type': 'ContactPage', name: 'Contact Sell My Junk Car TX', url: 'https://sellmyjunkcartx.com/contact', mainEntity: { '@type': 'LocalBusiness', name: 'Sell My Junk Car TX', telephone: '+1-832-622-2792', email: 'Cashforcartx@gmail.com', areaServed: 'Houston, Texas' } };
---
<BaseLayout title="Contact Sell My Junk Car TX | Houston" description="Contact Sell My Junk Car TX by phone, WhatsApp or email about a used, damaged or non-running vehicle in Houston." canonical="/contact" schema={schema}>
  <PageHero eyebrow="Get in touch" title="Talk to the vehicle team." description="Use phone, WhatsApp or email. The team will review the request and follow up." pageName="Contact" />
  <section class="section"><div class="container contact-layout"><aside><h2>Choose the easiest channel.</h2><p>For a faster vehicle offer request, include the make, model, year and current condition.</p><div class="contact-methods"><a class="contact-method" href="tel:+18326222792" data-track="phone_clicked"><strong>(832) 622-2792</strong><span>Call the Houston team</span></a><a class="contact-method" href="https://wa.me/18326222792" target="_blank" rel="noopener" data-track="whatsapp_clicked"><strong>WhatsApp</strong><span>Message vehicle details</span></a><a class="contact-method" href="mailto:Cashforcartx@gmail.com"><strong>Cashforcartx@gmail.com</strong><span>Send an email</span></a></div></aside>
    <form class="form-shell" data-contact-form novalidate><div class="form-panel"><h2>Prepare an email</h2><p class="form-intro">Complete the fields and your email app will open with the message ready.</p><div class="field-grid">
      <div class="field"><label for="contact-name">Full name</label><input id="contact-name" name="name" autocomplete="name" required /><span class="field-error" id="contact-name-error" aria-live="polite"></span></div>
      <div class="field"><label for="contact-email">Email</label><input id="contact-email" name="email" type="email" autocomplete="email" required /><span class="field-error" id="contact-email-error" aria-live="polite"></span></div>
      <div class="field"><label for="contact-phone">Phone <small>(optional)</small></label><input id="contact-phone" name="phone" type="tel" autocomplete="tel" /><span class="field-error" aria-hidden="true"></span></div>
      <div class="field"><label for="contact-vehicle">Vehicle <small>(optional)</small></label><input id="contact-vehicle" name="vehicle" placeholder="Make, model and year" /><span class="field-error" aria-hidden="true"></span></div>
      <div class="field field-full"><label for="contact-message">Message <small>(optional)</small></label><textarea id="contact-message" name="message" placeholder="Tell us about the vehicle condition or pickup location."></textarea><span class="field-error" aria-hidden="true"></span></div>
    </div><button class="button button-primary" type="submit">Prepare my email</button><p class="notice" data-contact-status hidden aria-live="polite"></p></div></form>
  </div></section>
</BaseLayout>

<section class="section" id="quote">
  <div class="container quote-layout">
    <aside class="quote-aside reveal">
      <p class="kicker">Start with the basics</p>
      <h2>Details in. Offer out.</h2>
      <p>This short request prepares a WhatsApp message for the team. A final offer follows vehicle inspection.</p>
      <ul class="check-list"><li>No obligation to accept</li><li>Your details are not sold for advertising</li><li>Documentation is verified before payment</li></ul>
    </aside>
    <form class="form-shell reveal" data-quote-form novalidate>
      <div class="form-progress" aria-label="Quote progress">
        <button type="button" class="progress-step is-active" data-progress-step="1" aria-current="step"><span>1 of 3</span><strong>Vehicle</strong></button>
        <button type="button" class="progress-step" data-progress-step="2"><span>2 of 3</span><strong>Condition</strong></button>
        <button type="button" class="progress-step" data-progress-step="3"><span>3 of 3</span><strong>Contact</strong></button>
      </div>
      <div class="form-panel" data-form-panel>
        <section class="form-step" data-step="1">
          <h3 tabindex="-1">What vehicle are you selling?</h3><p class="form-intro">Basic information is enough to begin.</p>
          <div class="field-grid">
            <div class="field field-full"><label for="makeModel">Make and model</label><input id="makeModel" name="makeModel" type="text" placeholder="For example, Ford F-150" aria-describedby="makeModel-error" required /><span class="field-error" id="makeModel-error" aria-live="polite"></span></div>
            <div class="field"><label for="year">Year</label><input id="year" name="year" type="number" inputmode="numeric" min="1900" max="2027" placeholder="2012" aria-describedby="year-error" required /><span class="field-error" id="year-error" aria-live="polite"></span></div>
            <div class="field"><label for="mileage">Mileage <small>(optional)</small></label><input id="mileage" name="mileage" type="number" inputmode="numeric" min="0" placeholder="125000" /><span class="field-error" aria-hidden="true"></span></div>
          </div>
          <div class="form-actions"><span></span><button class="button button-primary" type="button" data-next>Continue to condition</button></div>
        </section>
        <section class="form-step" data-step="2" hidden>
          <h3 tabindex="-1">Which description fits best?</h3><p class="form-intro">Choose the closest match. The team confirms the condition during inspection.</p>
          <div class="choice-grid" role="radiogroup" aria-describedby="condition-error">
            <div class="choice"><input id="condition-used" name="condition" type="radio" value="Used and running" required /><label for="condition-used">Used and running<span>Older vehicle in working condition</span></label></div>
            <div class="choice"><input id="condition-nonrunning" name="condition" type="radio" value="Does not start" required /><label for="condition-nonrunning">Does not start<span>Mechanical or starting problem</span></label></div>
            <div class="choice"><input id="condition-damaged" name="condition" type="radio" value="Damaged or wrecked" required /><label for="condition-damaged">Damaged or wrecked<span>Body or accident damage</span></label></div>
            <div class="choice"><input id="condition-transmission" name="condition" type="radio" value="Transmission problem" required /><label for="condition-transmission">Transmission problem<span>Repair may not make sense</span></label></div>
          </div>
          <span class="field-error" id="condition-error" aria-live="polite"></span>
          <div class="form-actions"><button class="button button-quiet" type="button" data-back>Back</button><button class="button button-primary" type="button" data-next>Continue to contact</button></div>
        </section>
        <section class="form-step" data-step="3" hidden>
          <h3 tabindex="-1">Where should we send the follow-up?</h3><p class="form-intro">Your phone number is used to continue the offer request.</p>
          <div class="field-grid">
            <div class="field"><label for="name">Full name</label><input id="name" name="name" type="text" autocomplete="name" placeholder="Your name" aria-describedby="name-error" required /><span class="field-error" id="name-error" aria-live="polite"></span></div>
            <div class="field"><label for="phone">Phone or WhatsApp</label><input id="phone" name="phone" type="tel" autocomplete="tel" placeholder="(832) 555-0123" aria-describedby="phone-error" required /><span class="field-error" id="phone-error" aria-live="polite"></span></div>
            <div class="field field-full"><label for="email">Email <small>(optional)</small></label><input id="email" name="email" type="email" autocomplete="email" placeholder="you@example.com" /><span class="field-error" id="email-error" aria-live="polite"></span></div>
          </div>
          <p class="form-disclaimer">By continuing, you ask Sell My Junk Car TX to review these details and contact you about the vehicle. See the <a href="/privacy">Privacy Policy</a>.</p>
          <div class="form-actions"><button class="button button-quiet" type="button" data-back>Back</button><button class="button button-primary" type="submit">Prepare my offer request</button></div>
        </section>
      </div>
      <div class="form-success" data-form-success hidden><span class="success-mark" aria-hidden="true">✓</span><h3 tabindex="-1">Your details are ready.</h3><p>Send them to the team on WhatsApp to continue your offer request.</p><a class="button button-primary" href="https://wa.me/13239497072" target="_blank" rel="noopener" data-whatsapp-result data-track="whatsapp_clicked">Send details on WhatsApp</a></div>
    </form>
  </div>
</section>
